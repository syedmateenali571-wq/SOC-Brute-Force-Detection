index=main sourcetype="linux:ssh" ("Failed password" OR "Accepted password")
| rex field=_raw "(?:Failed|Accepted) password for \S+ from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| eval auth_result=if(match(_raw,"Failed password"),"Failed","Successful")
| stats count(eval(auth_result="Failed")) as failed_attempts count(eval(auth_result="Successful")) as successful_logins earliest(_time) as first_seen latest(_time) as last_seen by src_ip
| where failed_attempts >= 3 AND successful_logins >= 1
| convert ctime(first_seen) ctime(last_seen)
| table src_ip failed_attempts successful_logins first_seen last_seen