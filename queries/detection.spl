index=main sourcetype="linux:ssh" "Failed password"
| rex field=_raw "Failed password for \S+ from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| stats count as failed_attempts earliest(_time) as first_seen latest(_time) as last_seen by src_ip
| where failed_attempts >= 3
| convert ctime(first_seen) ctime(last_seen)
| sort - failed_attempts